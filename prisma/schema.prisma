// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  phone     String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  properties      Property[]
  bills           Bill[]
  payments        Payment[]
  notifications   Notification[]
  supportTickets  SupportTicket[]
  auditLogs       AuditLog[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  CUSTOMER
}

// Property Management
model Property {
  id          String   @id @default(cuid())
  name        String
  address     String
  city        String
  postalCode  String
  country     String   @default("Greece")
  type        PropertyType
  totalUnits  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner    User   @relation(fields: [ownerId], references: [id])
  ownerId  String
  units    Unit[]
  bills    Bill[]

  @@index([ownerId])
  @@index([city])
  @@map("properties")
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  BUILDING
}

model Unit {
  id          String   @id @default(cuid())
  unitNumber  String
  floor       Int?
  area        Float?
  bedrooms    Int?
  bathrooms   Int?
  isOccupied  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  property   Property       @relation(fields: [propertyId], references: [id])
  propertyId String
  meters     Meter[]

  @@unique([propertyId, unitNumber])
  @@index([propertyId])
  @@map("units")
}

// Meter Management
model Meter {
  id             String     @id @default(cuid())
  meterNumber    String     @unique
  type           MeterType
  installDate    DateTime
  lastReadingDate DateTime?
  status         MeterStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  unit       Unit           @relation(fields: [unitId], references: [id])
  unitId     String
  readings   MeterReading[]

  @@index([unitId])
  @@index([meterNumber])
  @@map("meters")
}

enum MeterType {
  ELECTRICITY
  WATER
  GAS
  HEATING
}

enum MeterStatus {
  ACTIVE
  INACTIVE
  FAULTY
  REPLACED
}

model MeterReading {
  id           String   @id @default(cuid())
  reading      Float
  readingDate  DateTime
  readingType  ReadingType @default(MANUAL)
  notes        String?
  createdAt    DateTime @default(now())

  // Relations
  meter    Meter  @relation(fields: [meterId], references: [id])
  meterId  String

  @@index([meterId])
  @@index([readingDate])
  @@map("meter_readings")
}

enum ReadingType {
  MANUAL
  AUTOMATIC
  ESTIMATED
}

// Billing System
model Bill {
  id             String      @id @default(cuid())
  billNumber     String      @unique
  periodStart    DateTime
  periodEnd      DateTime
  dueDate        DateTime
  issueDate      DateTime    @default(now())
  status         BillStatus  @default(PENDING)
  totalAmount    Float
  consumption    Float?
  rate           Float?
  taxes          Float       @default(0)
  fees           Float       @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // Relations
  user       User      @relation(fields: [userId], references: [id])
  userId     String
  property   Property  @relation(fields: [propertyId], references: [id])
  propertyId String
  payments   Payment[]

  @@index([userId])
  @@index([propertyId])
  @@index([status])
  @@index([dueDate])
  @@map("bills")
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

// Payment System
model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(COMPLETED)
  transactionId   String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String
  bill   Bill   @relation(fields: [billId], references: [id])
  billId String

  @@index([userId])
  @@index([billId])
  @@index([paymentDate])
  @@map("payments")
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  CASH
  ONLINE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Notification System
model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationType {
  BILL
  PAYMENT
  ALERT
  MAINTENANCE
  ANNOUNCEMENT
}

// Support System
model SupportTicket {
  id          String        @id @default(cuid())
  ticketNumber String       @unique
  subject     String
  description String
  status      TicketStatus  @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  closedAt    DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([status])
  @@map("support_tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Audit Log
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
